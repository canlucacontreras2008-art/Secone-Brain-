ANTHROPIC_API_KEY=

# Model used for chat, tasks, and self-reflection. Defaults to the flagship model;
# change this yourself if you want a cheaper/faster model instead.
BRAIN_MODEL=claude-opus-5

BRAIN_DB_PATH=brain.db
BRAIN_MAX_TOOL_ITERATIONS=8
BRAIN_MEMORY_RECALL_LIMIT=6

# Google Calendar + Gmail (shared OAuth app/token) - see README "Calendar" /
# "Gmail" sections for how to get these. credentials.json/token.json paths
# rarely need changing from the defaults.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_ID=primary
# Leave blank to use the server's own local timezone; set to your own IANA
# timezone name (e.g. America/New_York) if the server runs somewhere else.
BRAIN_TIMEZONE=

# Phone timer (MacroDroid) - see README "Phone timer" for the one-time
# macro setup that gives you this URL. Leave blank to disable the tool.
MACRODROID_WEBHOOK_URL=
